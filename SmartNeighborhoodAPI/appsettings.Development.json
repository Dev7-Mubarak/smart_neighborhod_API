{
  "Serilog": {
    "MinimumLevel": {
      //"Default": "Information",
      //"Override": {
      //  "Microsoft.EntityFrameworkCore": "Information",
      //  "Microsoft.AspNetCore": "Warning",
      //  "Microsoft.AspNetCore.Hosting": "Information",
      //  "System": "Warning"
      //}
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({MachineName}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}